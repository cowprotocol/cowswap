    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19",
        "graphql": "16",
        "cross-fetch": "4",
        "@walletconnect/ethereum-provider": "2.23"
      },
      "ignoreMissing": [
