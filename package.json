{
  "name": "cowswap-monorepo",
  "version": "2.0.0",
  "description": "CoW Protocol",
  "main": "index.js",
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.3",
  "config": {
    "enabledApps": "cowswap-frontend abis ui ui-utils widget-lib widget-react"
  },
  "scripts": {
    "start": "pnpm run start:cowswap",
    "start:cowswap": "cross-env NODE_ENV=development nx run cowswap-frontend:serve",
    "start:widget": "nx run widget-configurator:serve",
    "start:omnibridge-hook": "nx run hook-dapp-omnibridge:serve",
    "start:cosmos": "nx run cowswap-frontend:cosmos:run",
    "start:cosmos:explorer": "nx run explorer:cosmos:run",
    "start:explorer": "cross-env NODE_ENV=development nx run explorer:serve",
    "storybook": "nx run storybook:storybook",
    "storybook:build": "nx run storybook:build",
    "start:cowfi": "cross-env PORT=3001 nx run cow-fi:dev",
    "start:sdk-tools": "nx run sdk-tools:serve",
    "start:rwa": "cross-env PORT=3002 nx run rwa-frontend:dev",
    "e2e": "nx run cowswap-e2e-tests:e2e",
    "e2e:patient": "cross-env TIMEOUT_MULTIPLIER=20 nx run cowswap-e2e-tests:e2e",
    "e2e:build-cache": "nx run cowswap-e2e-tests:e2e:build-cache",
    "e2e:smoke": "nx run cowswap-e2e-tests:e2e:smoke",
    "e2e:ui": "nx run cowswap-e2e-tests:e2e:ui",
    "e2e:record-mocks": "nx run cowswap-e2e-tests:e2e:record-mocks",
    "build": "pnpm run build:cowswap",
    "build:all": "cross-env NODE_OPTIONS=--max-old-space-size=8192 nx run-many -t build --no-cloud",
    "build:cowswap": "cross-env NODE_ENV=production NODE_OPTIONS=--max-old-space-size=8192 nx build cowswap-frontend --no-cloud",
    "build:explorer": "nx build explorer --no-cloud",
    "build:widget": "nx build widget-configurator --no-cloud",
    "build:cowfi": "nx build cow-fi --no-cloud && pnpm run postbuild:cowfi",
    "build:sdk-tools": "nx build sdk-tools",
    "build:rwa": "nx build rwa-frontend --no-cloud",
    "postbuild:cowfi": "next-sitemap --config ./apps/cow-fi/next-sitemap.config.js",
    "clean": "git clean -fixd -e .env.local",
    "build:cosmos": "nx run cowswap-frontend:build:cosmos",
    "ci:build": "pnpm run build:cowswap && pnpm run build-widget",
    "nx": "npx nx run",
    "ipfs": "nx run cowswap-frontend:ipfs",
    "i18n": "nx run-many -t i18n",
    "i18n:extract": "nx run-many -t i18n:extract",
    "preview": "NODE_OPTIONS=--max-old-space-size=8192 nx run cowswap-frontend:preview",
    "test": "pnpm run test:all && pnpm run test:tools",
    "test:all": "nx run-many -t test",
    "test:tools": "node --test tools/scripts/*.test.mjs",
    "typecheck": "nx run cowswap-frontend:typecheck && pnpm run typecheck:workspaces",
    "typecheck:workspaces": "node tools/scripts/typecheck-workspaces.mjs",
    "lint": "nx run-many -t lint",
    "agents:check": "node tools/scripts/agents-check.mjs && node tools/scripts/check-pinned-package-versions.mjs",
    "lint:fix": "pnpm run lint --fix --skip-nx-cache",
    "lint:verbose": "pnpm run lint --output-style=stream --parallel=1 --skip-nx-cache",
    "lint-staged": "lint-staged --verbose -c lint-staged.config.js",
    "prebuild:cowswap": "node tools/scripts/prebuild.js",
    "upgrade-sdk-preview": "node tools/scripts/update-sdk-preview.js",
    "upgrade-sdk-latest": "node tools/scripts/upgrade-sdk-latest.js",
    "update-widget-sdk-versions": "node apps/widget-configurator/scripts/widget-sdk-versions.script.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version && node tools/scripts/format-changelog-headers.mjs",
    "release:generate-changesets": "node tools/scripts/commits-to-changesets.mjs",
    "prepare": "husky",
    "analyze-build": "rm -rf build/cowswap && cross-env ANALYZE_BUNDLE=true ANALYZE_BUNDLE_TEMPLATE=sunburst pnpm run build:cowswap -- --skip-nx-cache",
    "bundle:size": "node node_modules/@cowprotocol/dx/bundle-size.mjs",
    "install:ci": "pnpm install --frozen-lockfile"
  },
  "browser": {
    "crypto": false
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!@ledgerhq/connect-kit-loader)"
    ]
  },
  "resolutions": {
    "@babel/traverse": "7.28.6",
    "@types/react": "19.1.3",
    "@types/react-dom": "19.1.3",
