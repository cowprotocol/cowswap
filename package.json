    "@walletconnect/types": "2.23.10",
    "@walletconnect/universal-provider": "2.23.10",
    "@walletconnect/utils": "2.23.10",
    "stylus": "npm:empty-npm-package@1.0.0",
    "utf-8-validate": "5.0.10"
  },
  "engines": {
    "node": ">=20.19 <23",
    "pnpm": ">=10 <11"
  },
  "engineStrict": true,
