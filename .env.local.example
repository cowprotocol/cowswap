# Copy this file to .env.local to enable development features

# Safe API authentication token (required for Safe Transaction Service API calls)
# Get your token at https://app.safe.global/settings/api-keys
REACT_APP_SAFE_API_AUTH_TOKEN=

# CoW Speech Bubble Notification
REACT_APP_FORCE_SPEECH_BUBBLE_NOTIFICATION=true

# Graffiti Wall
# Off by default everywhere; in deployed environments it is driven by the
# `isGraffitiWallEnabled` LaunchDarkly flag. LaunchDarkly has no client id locally,
# so this env var is the only way to turn the wall on in development.
REACT_APP_GRAFFITI_WALL_ENABLED=true

# Enable Telegram development bypass mode
# When enabled, Telegram verification is bypassed and uses a mock user (@devuser)
REACT_APP_TG_DEV_BYPASS=true

#######################################
# End To End Test
#######################################
# ⚠️ Required for E2E tests to run
