# Copy this file to .env.local to enable development features

# LaunchDarkly flag overrides. No client-side ID is configured for local dev, so the SDK never
# attempts a flag evaluation and every flag stays undefined. BOOT_FEATURE_FLAGS covers the few
# flags read before React exists (the wallet config); FEATURE_FLAGS covers everything else.
REACT_APP_BOOT_FEATURE_FLAGS='{"isSolanaEnabled":true}'
REACT_APP_FEATURE_FLAGS='{"isSolanaEnabled":true,"isAlphaNetworksOptionVisible":true,"isSolanaThemeEnabled":true}'

# Safe API authentication token (required for Safe Transaction Service API calls)
# Get your token at https://app.safe.global/settings/api-keys
REACT_APP_SAFE_API_AUTH_TOKEN=

# CoW Speech Bubble Notification
REACT_APP_FORCE_SPEECH_BUBBLE_NOTIFICATION=true

# Graffiti Wall
# On by default in development, driven by the `isGraffitiWallEnabled` LaunchDarkly
# flag elsewhere. Uncomment to match the deployed default (off).
# REACT_APP_GRAFFITI_WALL_ENABLED=false

# Enable Telegram development bypass mode
# When enabled, Telegram verification is bypassed and uses a mock user (@devuser)
REACT_APP_TG_DEV_BYPASS=true

#######################################
# End To End Test
#######################################
# ⚠️ Required for E2E tests to run
