    {
      "type": "stat",
      "id": 6,
      "title": "Failed calls",
      "description": "HTTP errors and network errors, share of all upstream calls.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "{namespace=\"vercel\"} parsed.service:=rwa-frontend parsed.env:~\"^${env:regex}$\" _msg:=\"upstream request\" parsed.upstream:=coingecko parsed.api:~\"^${api:regex}$\" | stats count() as total, count() if (-parsed.outcome:=ok) as failed | math failed * 100 / total as failed_percent | fields failed_percent",
          "queryType": "stats",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      }
    },
