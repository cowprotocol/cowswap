{
  "title": "RWA frontend: CoinGecko usage",
  "uid": "rwa-coingecko-usage",
  "description": "CoinGecko API consumption and API route traffic of rwa-frontend, from its pino logs",
  "tags": [
    "rwa",
    "coingecko",
    "vercel"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "5m",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "VictoriaLogs",
        "type": "datasource",
        "query": "victoriametrics-logs-datasource",
        "current": {
          "text": "VictoriaLogs Staging",
          "value": "vm-auth-staging"
        },
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "production,preview,development",
        "current": {
          "text": "production",
          "value": "production"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "hide": 0,
        "options": []
      },
      {
        "name": "api",
        "label": "API",
        "type": "custom",
        "query": "pro,demo,public,geckoterminal",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "hide": 0,
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "CoinGecko consumption",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Billed calls",
      "description": "Requests sent to the CoinGecko Pro or Demo API in the time range, one credit each. Keyless and GeckoTerminal calls cost no credits and are excluded.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "{namespace=\"vercel\"} parsed.service:=rwa-frontend parsed.env:~\"^${env:regex}$\" _msg:=\"upstream request\" parsed.upstream:=coingecko parsed.api:~\"^${api:regex}$\" parsed.api:in(pro, demo) | stats count() as calls",
          "queryType": "stats",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Projected calls / 30 days",
      "description": "Billed calls of the time range extrapolated to 30 days. Compare it with the monthly credit allowance of the plan.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "{namespace=\"vercel\"} parsed.service:=rwa-frontend parsed.env:~\"^${env:regex}$\" _msg:=\"upstream request\" parsed.upstream:=coingecko parsed.api:~\"^${api:regex}$\" parsed.api:in(pro, demo) | stats count() as calls | math round(calls * 2592000 / $__range_s) as projected | fields projected",
          "queryType": "stats",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
