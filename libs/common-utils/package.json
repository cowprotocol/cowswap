{
  "name": "@cowprotocol/common-utils",
  "version": "3.13.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cowprotocol/cowswap.git",
    "directory": "libs/common-utils"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.d.ts",
  "license": "ISC",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.js",
      "import": "./src/*.js",
      "require": "./src/*.js",
      "default": "./src/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./index.js",
    "types": "./index.d.ts",
    "exports": {
      ".": {
        "types": "./index.d.ts",
        "import": "./index.js",
        "require": "./index.cjs"
      },
      "./*": {
        "types": "./*.d.ts",
        "import": "./*.js",
        "require": "./*.cjs"
      }
    }
  },
  "dependencies": {
    "@cowprotocol/common-const": "workspace:*",
    "@cowprotocol/cow-sdk": "9.2.6",
    "@cowprotocol/currency": "workspace:*",
    "@cowprotocol/types": "workspace:*",
    "@lingui/core": "5.5.1",
    "@lingui/macro": "5.5.1",
    "@lingui/react": "5.5.1",
    "@sentry/browser": "7.80.0",
    "@sentry/react": "7.80.0",
    "bignumber.js": "9.1.2",
    "cids": "1.1.9",
    "fast-safe-stringify": "2.1.1",
    "jotai-family": "1.0.1",
    "jotai": "2.2.0",
    "jsbi": "3.2.5",
    "ms": "2.1.3",
    "multicodec": "3.2.1",
    "multihashes": "4.0.3",
    "quick-lru": "7.0.0",
    "react": "19.1.2",
    "safe-stable-stringify": "2.5.0",
    "ua-parser-js": "1.0.38",
    "viem": "2.48.8",
    "wagmi": "3.6.9"
  },
  "devDependencies": {
    "@types/ms": "2.1.0",
    "@types/react": "19.1.3",
    "@types/ua-parser-js": "0.7.36"
  }
}
