{
  "name": "@cowprotocol/analytics",
  "version": "3.17.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./order-lifecycle": {
      "types": "./src/widget/orderLifecyclePayloads.ts",
      "import": "./src/widget/orderLifecyclePayloads.ts",
      "require": "./src/widget/orderLifecyclePayloads.ts",
      "default": "./src/widget/orderLifecyclePayloads.ts"
    },
    "./consent": {
      "types": "./src/consent/index.ts",
      "import": "./src/consent/index.ts",
      "require": "./src/consent/index.ts",
      "default": "./src/consent/index.ts"
    }
  },
  "publishConfig": {
    "main": "./index.js",
    "types": "./index.d.ts",
    "exports": {
      ".": {
        "types": "./index.d.ts",
        "import": "./index.mjs",
        "require": "./index.js"
      },
      "./order-lifecycle": {
        "types": "./widget/orderLifecyclePayloads.d.ts",
        "import": "./widget/orderLifecyclePayloads.mjs",
        "require": "./widget/orderLifecyclePayloads.js"
      },
      "./consent": {
        "types": "./consent/index.d.ts",
        "import": "./consent/index.mjs",
        "require": "./consent/index.js"
      }
    }
  },
  "dependencies": {
    "@cowprotocol/cow-sdk": "9.3.3",
    "@cowprotocol/common-const": "workspace:*",
    "@cowprotocol/common-hooks": "workspace:*",
    "@cowprotocol/common-utils": "workspace:*",
    "@cowprotocol/events": "workspace:*",
    "@cowprotocol/types": "workspace:*",
    "@cowprotocol/currency": "workspace:*",
    "react": "19.1.2",
    "react-router": "7.5.2",
    "web-vitals": "2.1.4",
    "viem": "2.55.19"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.3"
  }
}
