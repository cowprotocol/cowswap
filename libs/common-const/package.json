{
  "name": "@cowprotocol/common-const",
  "version": "3.16.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens.ts",
      "import": "./src/tokens.ts",
      "require": "./src/tokens.ts",
      "default": "./src/tokens.ts"
    },
    "./wallet": {
      "types": "./src/wallet.ts",
      "import": "./src/wallet.ts",
      "require": "./src/wallet.ts",
      "default": "./src/wallet.ts"
    }
  },
  "publishConfig": {
    "main": "./index.js",
    "types": "./index.d.ts",
    "exports": {
      ".": {
        "types": "./index.d.ts",
        "import": "./index.mjs",
        "require": "./index.js"
      },
      "./tokens": {
        "types": "./tokens.d.ts",
        "import": "./tokens.mjs",
        "require": "./tokens.js"
      },
      "./wallet": {
        "types": "./wallet.d.ts",
        "import": "./wallet.mjs",
        "require": "./wallet.js"
      }
    }
  },
  "dependencies": {
    "@cowprotocol/cow-sdk": "9.2.21",
    "viem": "2.57.7",
    "@cowprotocol/types": "workspace:*",
    "@lingui/core": "5.5.1",
    "@cowprotocol/currency": "workspace:*",
    "jsbi": "3.2.5",
    "ms.macro": "2.0.0"
  },
  "devDependencies": {
    "@types/ms.macro": "2.0.0"
  }
}
