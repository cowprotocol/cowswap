{
  "name": "@cowprotocol/common-const",
  "version": "3.19.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens.ts",
      "import": "./src/tokens.ts",
      "require": "./src/tokens.ts",
      "default": "./src/tokens.ts"
    },
    "./theme": {
      "types": "./src/theme.ts",
      "import": "./src/theme.ts",
      "require": "./src/theme.ts",
      "default": "./src/theme.ts"
    },
    "./wallet": {
      "types": "./src/wallet.ts",
      "import": "./src/wallet.ts",
      "require": "./src/wallet.ts",
      "default": "./src/wallet.ts"
    },
    "./cowLinks": {
      "types": "./src/cowLinks.ts",
      "import": "./src/cowLinks.ts",
      "require": "./src/cowLinks.ts",
      "default": "./src/cowLinks.ts"
    }
  },
  "publishConfig": {
    "main": "./index.js",
    "types": "./index.d.ts",
    "exports": {
      ".": {
        "types": "./index.d.ts",
        "import": "./index.mjs",
        "require": "./index.js"
      },
      "./tokens": {
        "types": "./tokens.d.ts",
        "import": "./tokens.mjs",
        "require": "./tokens.js"
      },
      "./theme": {
        "types": "./theme.d.ts",
        "import": "./theme.mjs",
        "require": "./theme.js"
      },
      "./wallet": {
        "types": "./wallet.d.ts",
        "import": "./wallet.mjs",
        "require": "./wallet.js"
      },
      "./cowLinks": {
        "types": "./cowLinks.d.ts",
        "import": "./cowLinks.mjs",
        "require": "./cowLinks.js"
      }
    }
  },
  "dependencies": {
    "@cowprotocol/cow-sdk": "9.3.3",
    "viem": "2.55.19",
    "@cowprotocol/types": "workspace:*",
    "@lingui/core": "5.5.1",
    "@cowprotocol/currency": "workspace:*",
    "jsbi": "3.2.5",
    "ms.macro": "2.0.0"
  },
  "devDependencies": {
    "@types/ms.macro": "2.0.0"
  }
}
